# API (production: Railway backend only, e.g. https://xxx.up.railway.app — not your Vercel site URL)
VITE_API_URL=http://localhost:3000

# Supabase
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Auth redirect for email confirmation links. Required in production.
# Set to your deployed URL (e.g. https://kolia-restaurant.vercel.app)
# so confirmation emails don't redirect to localhost.
VITE_SITE_URL=https://kolia-restaurant.vercel.app
